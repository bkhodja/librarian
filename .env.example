# Books folder path - Update this to your actual Books folder location
BOOKS_FOLDER=/Volumes/Storage/Books

# Server configuration
PORT=3001
NODE_ENV=development

# Database. Relative to the project root. Point this at a copy for any
# testing that deletes or merges books — see `npm run db:test`.
DATABASE_PATH=./data/librarian.db

# Background scanning, tagging and thumbnails. Defaults to on for the normal
# database and off for any other, so a test copy is not re-filled from disk.
# BACKGROUND_TASKS=on

# OCR Settings
# Scanned PDFs are read in the background, one book at a time in a low-priority
# process. On a Mac this uses Apple's Vision framework (tools/visionocr, built
# on first use with the Xcode command-line tools); elsewhere, or without
# swiftc, Tesseract. Set OCR_BACKGROUND=off to leave scans to scripts/index-pages.js --ocr.
OCR_BACKGROUND=on
OCR_LANGUAGE=eng+rus
OCR_CONFIDENCE_THRESHOLD=60
# Local AI via Ollama. No API keys, no cost, works offline.
# Install from https://ollama.com, then:
#   ollama pull qwen3.6:35b-a3b   # summaries, Ask, compare, tagging
#   ollama pull gemma3:4b         # cheap first pass of the adult-content check
# The 35B model is a mixture-of-experts with ~3B active parameters: about
# twice gemma3:4b's latency, and it names authors and cites pages where the
# small model does not. Needs ~24GB of RAM; on a smaller machine use gemma3:4b.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.6:35b-a3b
OLLAMA_ADULT_MODEL=gemma3:4b
OLLAMA_VERIFY_MODEL=qwen3.6:35b-a3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_MS=120000

# Summaries use the local model; without it they fall back to an excerpt.
SUMMARY_MAX_TOKENS=8000
SUMMARY_CHUNK_TOKENS=6000

# Auto-tagging
AI_TAGGER_MAX_TAGS=3
TAG_BATCH_SIZE=20

# Metadata enrichment (optional). Open Library needs no key. Google Books rate
# limits unauthenticated requests per IP and is skipped once it starts refusing;
# a key raises that quota.
GOOGLE_BOOKS_API_KEY=

# Background processing (optional overrides)
PROCESSOR_WORKERS=2
THUMBNAIL_BATCH_SIZE=25
THUMBNAIL_CONCURRENCY=3
ENRICH_BATCH_SIZE=25
ENRICH_DELAY_MS=1000
EMBED_BATCH_SIZE=100

# Library chat. Both default to OLLAMA_MODEL, which keeps one model loaded.
# Profiling reads each book's opening pages once (~6s a book, a few hours for
# a large library, a batch at a time in the background).
CHAT_MODEL=
PROFILE_MODEL=
PROFILE_BATCH_SIZE=20
